{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "无线麦",
  "version": "1.0.0",
  "identifier": "app.getsayall.remote-mic.windows",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:2430",
    "beforeBuildCommand": "node scripts/stage-bundle-inputs.cjs && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "无线麦 · 个人版",
        "width": 1066.67,
        "height": 800,
        "minWidth": 1066.67,
        "minHeight": 800,
        "decorations": true,
        "resizable": true,
        "dragDropEnabled": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "luck-gh",
    "resources": [
      "sayall-helper.exe",
      "frida-gadget.dll",
      "licenses/Frida-COPYING.txt",
      "licenses/ATTRIBUTION.md"
    ],
    "category": "Productivity",
    "shortDescription": "把 RC001/RC003 遥控器的语音和按键桥接到 Windows",
    "longDescription": "无线麦个人版；基于 GetSayAll Windows 项目，2026-10-06 修改。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/installer-hooks.nsh",
        "template": "windows/installer.nsi",
        "uninstallerIcon": "icons/icon.ico",
        "startMenuFolder": "无线麦"
      }
    },
    "license": "GPL-3.0-only"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY1NDg0MTUwODU3N0UyNUMKUldSYzRuZUZVRUZJOVhpWXJYNzVHdDZ6UVlUZm4wWk5JWTZ2Sm1XL0lmOWJnbThQWDM2dzAyMmkK",
      "endpoints": [
        "https://github.com/luck-gh/remote-mic-app-windows/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
